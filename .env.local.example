# Copy this file to .env.local and fill in your real keys.
# .env.local is already in .gitignore - never commit real keys.

# Get this from build.nvidia.com -> pick a model -> "Get API Key"
NVIDIA_API_KEY=nvapi-your-key-here

# Get this from console.anthropic.com -> API Keys
# Used only as a fallback if the Nemotron call fails.
ANTHROPIC_API_KEY=sk-ant-your-key-here

